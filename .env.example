# ============================================================
# RAG Multi-Agent - Environment Variables
# ============================================================

# --- OpenRouter API Keys (one or more) ---
OPENROUTER_API_KEY1=sk-or-...here

# --- Qdrant ---
QDRANT_URL=http://192.168.0.14:6333

# --- Embeddings (OpenRouter) ---
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# --- LLM (OpenRouter) ---
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Upload Service / API ---
API_BASE_URL=http://192.168.0.14:12010
API_USER=master
API_PASS=master

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://devuser:devpass@192.168.0.14:5432/devdb

# --- S3 / SeaweedFS ---
AWS_ACCESS_KEY_ID=changemeuser
AWS_SECRET_ACCESS_KEY=change...
S3_ENDPOINT_URL=http://192.168.0.14:9900
